# Copie para .env (o .env fica fora do git)
GEMINI_API_KEY=
# Pasta com uma subpasta por produto. Padrao: .\itens
ITEMS_PATH=
# Seu telefone (so numeros). Vazio = nao inclui telefone nas descricoes
PHONE_NUMBER=
# Opcional: caminho do chrome.exe se nao for detectado
CHROME_PATH=
# Cidade padrao dos anuncios sem cidade propria (vazio = a do seu Facebook). Ex.: Fortaleza, CE
DEFAULT_CITY=
# Caminho da planilha do modo -auto e -daemon (xlsx)
PLANILHA_PATH=
